                </div>
              </section>

              {/* UI險ｭ螳・*/}
              <section>
                <h3 className="text-lg font-semibold text-gray-800 mb-4">UI險ｭ螳・/h3>
                <div className="space-y-4">
                  {/* 繝√Ε繝・ヨ螳御ｺ・夂衍髻ｳ */}
                  <div className="flex items-center space-x-3">
                    <input
                      type="checkbox"
                      id="chatNotificationSound"
                      checked={formSettings.chatNotificationSound}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, chatNotificationSound: e.target.checked }))}
                      className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <label htmlFor="chatNotificationSound" className="text-sm font-medium text-gray-700">
                      繝√Ε繝・ヨ螳御ｺ・夂衍髻ｳ
                    </label>
                    <span className="text-xs text-gray-500">
                      粕 AI縺ｮ霑皮ｭ泌ｮ御ｺ・凾縺ｫ蜆ｪ縺励＞騾夂衍髻ｳ繧貞・逕・
                    </span>
                  </div>

                  {/* 蜷ｹ縺榊・縺鈴城℃邇・*/}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      蜷ｹ縺榊・縺鈴城℃邇・ {Math.round(formSettings.bubbleOpacity * 100)}%
                    </label>
                    <input
                      type="range"
                      min="0.3"
                      max="1"
                      step="0.1"
                      value={formSettings.bubbleOpacity}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, bubbleOpacity: parseFloat(e.target.value) }))}
                      className="w-full slider"
                    />
                    <div className="flex justify-between text-xs text-gray-500 mt-1">
                      <span>騾乗・</span>
                      <span>荳埼乗・</span>
                    </div>
                  </div>

                  {/* 蜷ｹ縺榊・縺励⊂縺九＠蜉ｹ譫・*/}
                  <div className="flex items-center space-x-3">
                    <input
                      type="checkbox"
                      id="bubbleBlur"
                      checked={formSettings.bubbleBlur}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, bubbleBlur: e.target.checked }))}
                      className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <label htmlFor="bubbleBlur" className="text-sm font-medium text-gray-700">
                      蜷ｹ縺榊・縺励ｒ縺ｼ縺九☆ (縺吶ｊ繧ｬ繝ｩ繧ｹ)
                    </label>
                  </div>

                  {/* LORA險ｭ螳・*/}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      LORA險ｭ螳・
                    </label>
                    <textarea
                      value={formSettings.loraSettings}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, loraSettings: e.target.value }))}
                      className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                      rows={3}
                      placeholder="萓・ <lora:character_name:0.8>"
                    />
                    <p className="text-xs text-gray-500 mt-1">
                      Stable Diffusion逕ｨ縺ｮLORA險ｭ螳壹ｒ蜈･蜉帙＠縺ｦ縺上□縺輔＞
                    </p>
                  </div>

                  {/* 繝阪ぎ繝・ぅ繝悶・繝ｭ繝ｳ繝励ヨ */}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      霑ｽ蜉繝阪ぎ繝・ぅ繝悶・繝ｭ繝ｳ繝励ヨ
                    </label>
                    <textarea
                      value={formSettings.negativePrompt}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, negativePrompt: e.target.value }))}
                      className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                      rows={2}
                      placeholder="萓・ lowres, bad anatomy, blurry"
                    />
                    <p className="text-xs text-gray-500 mt-1">
                      逕ｻ蜒冗函謌先凾縺ｫ閾ｪ蜍穂ｻ倅ｸ弱＆繧後ｋ繝阪ぎ繝・ぅ繝悶・繝ｭ繝ｳ繝励ヨ縺ｫ霑ｽ蜉縺輔ｌ縺ｾ縺・
                    </p>
                  </div>

                  {/* 逕ｻ蜒冗函謌舌お繝ｳ繧ｸ繝ｳ */}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      逕ｻ蜒冗函謌舌お繝ｳ繧ｸ繝ｳ
                    </label>
                    <select
                      value={formSettings.imageEngine}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, imageEngine: e.target.value as 'replicate' | 'sd' }))}
                      className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                    >
                      <option value="replicate">Replicate (繧ｯ繝ｩ繧ｦ繝・</option>
                      <option value="sd">Stable Diffusion (繝ｭ繝ｼ繧ｫ繝ｫ/URL)</option>
                    </select>
                    <p className="text-xs text-gray-500 mt-1">
                      Replicate 縺ｯ繝医・繧ｯ繝ｳ蠢・医ヾtable Diffusion 縺ｯ迺ｰ蠅・､画焚 LOCAL_SD_URL 繧定ｨｭ螳壹＠縺ｦ縺上□縺輔＞
                    </p>
                  </div>
                </div>
              </section>

              {/* 髻ｳ螢ｰ險ｭ螳・*/}
              <section>
                <h3 className="text-lg font-semibold text-gray-800 mb-4">髻ｳ螢ｰ險ｭ螳・/h3>
                <div className="space-y-4">
                  {/* 髻ｳ螢ｰ繧呈怏蜉ｹ蛹・*/}
                  <div className="flex items-center space-x-3">
                    <input
                      type="checkbox"
                      id="voiceEnabled"
                      checked={formSettings.voiceEnabled}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, voiceEnabled: e.target.checked }))}
                      className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <label htmlFor="voiceEnabled" className="text-sm font-medium text-gray-700">
                      髻ｳ螢ｰ繧呈怏蜉ｹ蛹・
                    </label>
                    <span className="text-xs text-gray-500">
                      痔 AI縺ｮ霑皮ｭ斐ｒ髻ｳ螢ｰ縺ｧ隱ｭ縺ｿ荳翫￡
                    </span>
                  </div>

                  {/* 閾ｪ蜍募・逕・*/}
                  <div className={`flex items-center space-x-3 ${!formSettings.voiceEnabled ? 'opacity-50' : ''}`}>
                    <input
                      type="checkbox"
                      id="voiceAutoPlay"
                      checked={formSettings.voiceAutoPlay}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, voiceAutoPlay: e.target.checked }))}
                      disabled={!formSettings.voiceEnabled}
                      className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <label htmlFor="voiceAutoPlay" className="text-sm font-medium text-gray-700">
                      閾ｪ蜍募・逕・
                    </label>
                    <span className="text-xs text-gray-500">
                      売 AI霑皮ｭ泌ｮ御ｺ・凾縺ｫ閾ｪ蜍輔〒髻ｳ螢ｰ蜀咲函
                    </span>
                  </div>

                  <div className={`grid grid-cols-1 md:grid-cols-2 gap-4 ${!formSettings.voiceEnabled ? 'opacity-50' : ''}`}>
                    {/* 髻ｳ螢ｰ騾溷ｺｦ */}
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-2">
                        髻ｳ螢ｰ騾溷ｺｦ: {formSettings.voiceSpeed}x
                      </label>
                      <input
                        type="range"
                        min="0.25"
                        max="2"
                        step="0.25"
                        value={formSettings.voiceSpeed}
                        onChange={(e) => setFormSettings(prev => ({ ...prev, voiceSpeed: parseFloat(e.target.value) }))}
                        disabled={!formSettings.voiceEnabled}
                        className="w-full slider"
                      />
                      <div className="flex justify-between text-xs text-gray-500 mt-1">
                        <span>0.25x</span>
                        <span>2.0x</span>
                      </div>
                    </div>

                    {/* 髻ｳ驥・*/}
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-2">
                        髻ｳ驥・ {Math.round(formSettings.voiceVolume * 100)}%
                      </label>
                      <input
                        type="range"
                        min="0"
                        max="1"
                        step="0.1"
                        value={formSettings.voiceVolume}
                        onChange={(e) => setFormSettings(prev => ({ ...prev, voiceVolume: parseFloat(e.target.value) }))}
                        disabled={!formSettings.voiceEnabled}
                        className="w-full slider"
                      />
                      <div className="flex justify-between text-xs text-gray-500 mt-1">
                        <span>0%</span>
                        <span>100%</span>
                      </div>
                    </div>
                  </div>

                  {/* ElevenLabs繝懊う繧ｹ驕ｸ謚・*/}
                  {voiceList.length > 0 && (
                    <div className="md:col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-2">
                        ElevenLabs 髻ｳ螢ｰ繝励Μ繧ｻ繝・ヨ
                      </label>
                      <select
                        value={formSettings.voiceId}
                        onChange={(e) => setFormSettings(prev => ({ ...prev, voiceId: e.target.value }))}
                        className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                      >
                        {voiceList.map(v => (
                          <option key={v.voice_id} value={v.voice_id}>{v.name}</option>
                        ))}
                      </select>
                      <p className="text-xs text-gray-500 mt-1">ElevenLabs 縺ｧ蛻ｩ逕ｨ蜿ｯ閭ｽ縺ｪ髻ｳ螢ｰ繧帝∈謚・/p>
                    </div>
                  )}
                </div>
              </section>

              {/* 繝励Ο繝ｳ繝励ヨ險ｭ螳・*/}
              <section>
                <h3 className="text-lg font-semibold text-gray-800 mb-4">繝励Ο繝ｳ繝励ヨ險ｭ螳・/h3>
                <div className="space-y-4">
                  {/* 髮ｻ逅・ｼ医う繝ｳ繧ｹ繝斐Ξ繝ｼ繧ｷ繝ｧ繝ｳ・峨・繝ｭ繝ｳ繝励ヨ */}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      庁 髮ｻ逅・ｼ医う繝ｳ繧ｹ繝斐Ξ繝ｼ繧ｷ繝ｧ繝ｳ・峨・繝ｭ繝ｳ繝励ヨ
                    </label>
                    <textarea
                      value={formSettings.inspirationPrompt || '縺ゅ↑縺溘・蜑ｵ菴懃噪縺ｧ閾ｪ辟ｶ縺ｪ繝ｦ繝ｼ繧ｶ繝ｼ霑比ｿ｡繧呈署譯医☆繧句ｰる摩AI縺ｧ縺吶・n\n縲舌く繝｣繝ｩ繧ｯ繧ｿ繝ｼ諠・ｱ縲曾n蜷榊燕: {{char}}\n諤ｧ譬ｼ繝ｻ迚ｹ蠕ｴ: {character.character_definition || character.description || \'荳肴・\'}\n\n縲舌Θ繝ｼ繧ｶ繝ｼ諠・ｱ縲曾n{persona ? \'蜷榊燕: {persona.name}\\n諤ｧ譬ｼ: {persona.description}\\n螂ｽ縺ｿ: {persona.likes?.join(\', \') || \'縺ｪ縺予'}\\n闍ｦ謇・ {persona.dislikes?.join(\', \') || \'縺ｪ縺予'}\\n蜿｣隱ｿ繝ｻ迚ｹ蠕ｴ: {persona.other_settings || \'縺ｪ縺予'}\' : \'荳闊ｬ逧・↑繝ｦ繝ｼ繧ｶ繝ｼ・亥錐蜑阪↑縺暦ｼ噂'}\n\n縲先怙譁ｰ縺ｮ繧ｭ繝｣繝ｩ繧ｯ繧ｿ繝ｼ逋ｺ險縲曾n縲鶏lastCharacterMessage}縲構n\n縲蝉ｼ夊ｩｱ縺ｮ譁・ц縲曾n{recentConversation}\n\n縲宣㍾隕∵欠遉ｺ縲曾n荳願ｨ倥・莨夊ｩｱ譁・ц繧定ｸ上∪縺医※縲√Θ繝ｼ繧ｶ繝ｼ縺瑚・辟ｶ縺ｫ霑斐＠縺昴≧縺ｪ霑比ｿ｡繧・縺､菴懈・縺励※縺上□縺輔＞縲・n\n縲占ｦ∽ｻｶ縲曾n- 50-70譁・ｭ礼ｨ句ｺｦ\n- 繝ｦ繝ｼ繧ｶ繝ｼ縺ｮ諤ｧ譬ｼ繝ｻ蜿｣隱ｿ繧貞渚譏\n- 莨夊ｩｱ繧定・辟ｶ縺ｫ逋ｺ螻輔＆縺帙ｋ蜀・ｮｹ\n- {{char}}縺ｨ縺ｮ髢｢菫よｧ縺ｫ驕ｩ縺励◆隕ｪ縺励∩蠎ｦ\n- 蜑ｵ騾逧・〒閾ｪ辟ｶ縺ｪ陦ｨ迴ｾ\n\n縲千ｦ∵ｭ｢隱槭曾n縲後◎縺・↑繧薙〒縺吶・縲阪後↑繧九⊇縺ｩ縲阪瑚ｩｳ縺励￥閨槭°縺帙※縲阪鶏{char}}縺輔ｓ繧峨＠縺・ｭ斐∴縺ｧ縺吶・縲構n\n閾ｪ辟ｶ縺ｪ霑比ｿ｡:'}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, inspirationPrompt: e.target.value }))}
                      className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                      rows={8}
                      placeholder="髮ｻ逅・・繧ｿ繝ｳ逕ｨ縺ｮ繝励Ο繝ｳ繝励ヨ繧貞・蜉・.."
                    />
                    <p className="text-xs text-gray-500 mt-1">
                      髮ｻ逅・・繧ｿ繝ｳ・芋汳｡・峨〒菴ｿ逕ｨ縺輔ｌ繧九・繝ｭ繝ｳ繝励ヨ縺ｧ縺吶・'{character.name}'}縲＋'{persona}'}縲＋'{lastCharacterMessage}'}縲＋'{recentConversation}'} 縺悟､画焚縺ｨ縺励※菴ｿ逕ｨ縺ｧ縺阪∪縺吶・
                    </p>
                  </div>

                  {/* 繧ｭ繝ｩ繧ｭ繝ｩ・域枚遶蠑ｷ蛹厄ｼ峨・繝ｭ繝ｳ繝励ヨ */}
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-2">
                      笨ｨ 繧ｭ繝ｩ繧ｭ繝ｩ・域枚遶蠑ｷ蛹厄ｼ峨・繝ｭ繝ｳ繝励ヨ
                    </label>
                    <textarea
                      value={formSettings.enhancementPrompt || '莉･荳九・繝ｦ繝ｼ繧ｶ繝ｼ縺ｮ繝・く繧ｹ繝医ｒ縲√ｈ繧企ｭ・鴨逧・〒陦ｨ迴ｾ雎翫°縺ｪ譁・ｫ縺ｫ蠑ｷ蛹悶＠縺ｦ縺上□縺輔＞縲・n\n{conversationContext}\n\n縲仙・縺ｮ繝・く繧ｹ繝医曾n{text}\n\n縲仙ｼｷ蛹悶・譁ｹ蜷第ｧ縲曾n- 諢滓ュ繧・ｰ玲戟縺｡繧偵ｈ繧雁・菴鍋噪縺ｧ鬲・鴨逧・↓陦ｨ迴ｾ\n- 迥ｶ豕√ｄ閭梧勹繧偵ｈ繧願ｩｳ縺励￥鬲・鴨逧・↓隱ｬ譏蚕n- 繝ｦ繝ｼ繧ｶ繝ｼ繧峨＠縺・・辟ｶ縺ｧ鬲・鴨逧・↑陦ｨ迴ｾ\n- 莨夊ｩｱ縺ｮ豬√ｌ繧定・・縺励◆閾ｪ辟ｶ縺ｪ陦ｨ迴ｾ\n- 300-400蟄礼ｨ句ｺｦ縺ｫ螟ｧ蟷・ｼｷ蛹暴n- 邨ｵ譁・ｭ励ｄ諢滓ュ陦ｨ迴ｾ繧帝←蛻・↓霑ｽ蜉\n- 繧医ｊ鬲・鴨逧・〒髱｢逋ｽ縺・｡ｨ迴ｾ縺ｫ螟画峩\n\n縲宣㍾隕√↑謖・､ｺ縲曾n- 蜈・・繝・く繧ｹ繝医・諢丞峙繧・・螳ｹ縺ｯ菫晄戟縺励※縺上□縺輔＞\n- 繝ｦ繝ｼ繧ｶ繝ｼ縺ｨ縺励※閾ｪ辟ｶ縺ｧ鬲・鴨逧・↑陦ｨ迴ｾ縺ｫ縺励※縺上□縺輔＞\n- 莨夊ｩｱ縺ｮ豬√ｌ繧定・・縺励※閾ｪ辟ｶ縺ｪ陦ｨ迴ｾ縺ｫ縺励※縺上□縺輔＞\n- 螟ｧ蟷・↓蠑ｷ蛹悶＠縺ｦ鬲・鴨逧・↓縺励※縺上□縺輔＞\n- JSON蠖｢蠑上〒縺ｯ縺ｪ縺上∝ｼｷ蛹悶＆繧後◆繝・く繧ｹ繝医・縺ｿ繧定ｿ斐＠縺ｦ縺上□縺輔＞\n- 驕諷ｮ縺帙★縺ｫ鬲・鴨逧・〒髱｢逋ｽ縺・｡ｨ迴ｾ縺ｫ縺励※縺上□縺輔＞\n\n蠑ｷ蛹悶＆繧後◆繝・く繧ｹ繝・'}
                      onChange={(e) => setFormSettings(prev => ({ ...prev, enhancementPrompt: e.target.value }))}
                      className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800"
                      rows={8}
                      placeholder="繧ｭ繝ｩ繧ｭ繝ｩ繝懊ち繝ｳ逕ｨ縺ｮ繝励Ο繝ｳ繝励ヨ繧貞・蜉・.."
                    />
                    <p className="text-xs text-gray-500 mt-1">
                      繧ｭ繝ｩ繧ｭ繝ｩ繝懊ち繝ｳ・遺惠・峨〒菴ｿ逕ｨ縺輔ｌ繧九・繝ｭ繝ｳ繝励ヨ縺ｧ縺吶・'{text}'}縲＋'{conversationContext}'} 縺悟､画焚縺ｨ縺励※菴ｿ逕ｨ縺ｧ縺阪∪縺吶・
                    </p>
                  </div>
                </div>
              </section>

              {/* 繝舌ャ繧ｯ繧｢繝・・ */}
              <section>
                <h3 className="text-lg font-semibold text-gray-800 mb-4">繝舌ャ繧ｯ繧｢繝・・</h3>
                <p className="text-xs text-gray-500 mb-2">繝√Ε繝・ヨ螻･豁ｴ繝ｻ繝｡繝｢繝ｻ險ｭ螳壹ｒ JSON 縺ｧ菫晏ｭ・/ 蠕ｩ蜈・＠縺ｾ縺・/p>
                <BackupControls />
              </section>
            </div>
          </div>

          {/* 繝輔ャ繧ｿ繝ｼ */}
          <div className="flex items-center justify-end gap-3 p-6 border-t border-gray-200 bg-gray-50/50" style={{ paddingBottom: 'calc(1rem + env(safe-area-inset-bottom))' }}>
            <button
              onClick={handleReset}
              className="px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors"
            >
              繝ｪ繧ｻ繝・ヨ
            </button>
            <button
              onClick={onClose}
              className="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
            >
              繧ｭ繝｣繝ｳ繧ｻ繝ｫ
            </button>
            <button
              onClick={handleSave}
              className="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors flex items-center gap-2"
            >
              <Save size={16} />
              菫晏ｭ・
            </button>
          </div>
        </div>
      </div>
    </>
  );
} 




